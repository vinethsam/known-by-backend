# APPLICATION: .env is loaded from the repository working directory.
APP_ENV=development
LOG_LEVEL=INFO
# Optional locally. Required in production. Send Authorization: Bearer <token>.
API_ACCESS_TOKEN=
# PORT is consumed by python -m app.serve (Railway injects it).
PORT=8000

# DATABASE: local SQLite; use PostgreSQL for both Railway services.
DATABASE_URL=sqlite:///./research.db
# Railway example: postgresql+psycopg://user:password@host:5432/database

# CLOUDFLARE: full existing endpoint including /fetch if that is its route.
STATIC_FETCH_WORKER_URL=
STATIC_FETCH_WORKER_SECRET=
FETCH_TIMEOUT_SECONDS=30
MAX_RESPONSE_BYTES=2000000
MAX_REDIRECTS=5

# BROWSER: fallback for thin successful JS shells only.
PLAYWRIGHT_ENABLED=true
BROWSER_TIMEOUT_SECONDS=30
BROWSER_MAX_REQUESTS=80
BROWSER_MAX_TOTAL_BYTES=8000000
BROWSER_SANDBOX=true
STATIC_MIN_READABLE_CHARS=250
# Browser binary path is managed by Playwright; Docker sets it to /opt/playwright.

# CONTENT / STRUCTURED ACQUISITION: JSON operator configuration, never model URLs.
RETAIN_RAW_CONTENT=false
RETAIN_COMPACTED_TEXT=true
RETRIEVAL_CACHE_TTL_SECONDS=3600
MAX_CACHE_BYTES_PER_JOB=20000000
MAX_STRUCTURED_PAGES=5
STRUCTURED_SOURCES=[]

# OPENROUTER: choose model IDs supporting the selected JSON format.
OPENROUTER_API_KEY=
OPENROUTER_SOURCE_MODEL=
OPENROUTER_EXTRACTION_MODEL=
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=2
OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_TOKENS=3000
OPENROUTER_RESPONSE_FORMAT=json_schema

# SEARCH: one replaceable provider; no separate provider SDK needed.
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
SEARCH_TIMEOUT_SECONDS=20
SEARCH_MIN_INTERVAL_SECONDS=1.1

# RESEARCH: each person is bounded, including provider retry attempts.
MAX_SEARCH_QUERIES_PER_PERSON=6
MAX_SEARCH_RESULTS_PER_QUERY=8
MAX_SOURCES_PER_PERSON=6
SOURCES_PER_ROUND=2
MAX_CONCURRENT_PEOPLE=3
MAX_CONCURRENT_FETCHES=4
PER_DOMAIN_CONCURRENCY=1
MAX_LLM_CALLS_PER_PERSON=30
MAX_TOKENS_PER_PERSON=100000
BUDGET_MESSAGE_OVERHEAD_TOKENS=1024
TARGET_FIELD_CONFIDENCE=85
MAX_SOURCES_WITHOUT_NEW_CLAIMS=3
PERSON_TIMEOUT_SECONDS=600

# PROCESSING: total selected Markdown and individual model calls are bounded.
MAX_MARKDOWN_CHARS=24000
CHUNK_SIZE=6000
CHUNK_OVERLAP=400
MAX_CHUNKS_PER_SOURCE=3

# BATCH: extra columns are retained without being treated as identity evidence.
MAX_BATCH_ROWS=100
MAX_UPLOAD_BYTES=5000000
MAX_XLSX_UNCOMPRESSED_BYTES=30000000
MAX_INPUT_COLUMNS=100

# WORKER: lease must exceed twice the heartbeat interval.
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=20
WORKER_MAX_ATTEMPTS=3

# CONFIDENCE: defaults are all centralised in app/config.py ScoringPolicy.
# Nested overrides avoid dozens of independent environment variable names.
# SCORING__REVIEW_THRESHOLD=75
# SCORING__CORROBORATION_STEP=0.08
# SCORING__DOMAIN_OVERRIDES={"example.gov":"government"}
# SCORING__AUTHORITY__EMPLOYER=0.9
# Use SCORING=<JSON object> for larger policy changes; see docs/confidence.md.

# Trial runs use these same production settings and provider interfaces.
